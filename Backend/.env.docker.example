DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False

ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,your-domain.example
CORS_ALLOWED_ORIGINS=https://your-frontend.example
CSRF_TRUSTED_ORIGINS=https://your-domain.example,https://your-frontend.example

# Set DATABASE_URL to use an external PostgreSQL provider such as Neon.
# When set, it takes precedence over POSTGRES_*.
DATABASE_URL=
POSTGRES_DB=portfolio_db
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Set all R2 values to store uploaded media in Cloudflare R2.
# R2_PUBLIC_DOMAIN must be a public hostname without a URL scheme.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

REDIS_URL=redis://redis:6379/1
PORTFOLIO_CACHE_TTL=300
PORTFOLIO_CACHE_VERSION=1

CODEFORCES_HANDLE=
LEETCODE_USERNAME=
INTEGRATION_TIMEOUT=12
INTEGRATION_CACHE_TTL=900
INTEGRATION_STALE_TTL=86400

SERVE_MEDIA=True
TIME_ZONE=Asia/Dhaka
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
